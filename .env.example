# The Python agent (agent/config.py) reads, in order: agent/.env, .env.local, .env, ../.env.
# Real environment variables win over all of them. Never commit a real key.
ANTHROPIC_API_KEY=          # ANTHROPIC_KEY also works
# NORA_MODEL=claude-sonnet-5-5
# NORA_EFFORT=medium
# NORA_AGENT_URL=http://127.0.0.1:8100   (read by the Next.js proxy; set automatically on Vercel)
# Texting Nora (npm run demo / npm run nora-sms), see NORA-SMS-SETUP.md
# NORA_SMS_NUMBER=+14085550123         this Mac's iMessage number, shown to members who join
# NORA_SMS_ALLOW=+14085550123          extra numbers that may text Nora without joining (comma-separated)
# NORA_SMS_MAX_REPLIES=60
# NORA_PUBLIC_URL=https://...          set automatically by npm run demo
# Hosting (see HOSTING.md). Unset locally.
# NORA_AGENT_SECRET=...                optional: same value on the shop and the agent; the agent refuses calls without it
# SITE_PASSWORD=...                    the shop asks for it (username "club", or set SITE_USER)
