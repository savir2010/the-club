# The Python agent (agent/config.py) reads, in order: agent/.env, .env.local, .env, ../.env.
# Real environment variables win over all of them. Never commit a real key.
ANTHROPIC_API_KEY=          # ANTHROPIC_KEY also works
# NORA_MODEL=claude-sonnet-5-5
# NORA_EFFORT=medium
# NORA_AGENT_URL=http://127.0.0.1:8100   (read by the Next.js proxy)
# Live iMessage bridge (npm run nora-sms), see NORA-SMS-SETUP.md
# NORA_SMS_ALLOW=+14085550123          numbers allowed to text Nora, comma-separated
# NORA_SMS_MAX_REPLIES=40
# NORA_PUBLIC_URL=http://this-mac.local:3100   optional tracking link in order texts
