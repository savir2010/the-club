{
  "name": "club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "agent:setup": "python3 -m venv agent/.venv && agent/.venv/bin/pip install -r agent/requirements.txt",
    "agent": "cd agent && .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100 --reload",
    "nora-sms": "cd agent && NORA_SMS_BRIDGE=1 .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100",
    "nora-sms:dry": "cd agent && NORA_SMS_BRIDGE=1 NORA_SMS_DRY_RUN=1 .venv/bin/uvicorn main:app --host 127.0.0.1 --port 8100"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.55.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
